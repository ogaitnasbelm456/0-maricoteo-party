            <!-- Logo / Nombre del Evento con ícono pixel Creeper -->
            <a href="#" class="font-display font-extrabold text-2xl sm:text-3xl tracking-tighter uppercase flex items-center gap-2.5">
                <svg class="w-7 h-7 text-green-500 drop-shadow-[0_0_8px_rgba(34,197,94,0.8)]" viewBox="0 0 8 8" fill="currentColor">
                    <rect x="0" y="0" width="8" height="8" rx="1" fill="#22c55e" fill-opacity="0.2"/>
                    <rect x="1" y="1" width="2" height="2" fill="#4ade80"/>
                    <rect x="5" y="1" width="2" height="2" fill="#4ade80"/>
                    <rect x="3" y="3" width="2" height="2" fill="#4ade80"/>
                    <rect x="2" y="4" width="4" height="2" fill="#4ade80"/>
                    <rect x="2" y="6" width="1" height="1" fill="#4ade80"/>
                    <rect x="5" y="6" width="1" height="1" fill="#4ade80"/>
