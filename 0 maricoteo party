    <!-- Scripts de Interactividad -->
    <script>
        lucide.createIcons();

        const STORAGE_KEY = '0_maricoteo_pagomovil_registros_v1';
        const ADMIN_PASS = '555';

        let currentTicketPriceUsd = 5;
        let currentTicketPriceBs = 5100;
        let currentTicketName = 'Entrada General';
        let currentTotalBsRaw = 5100;
        let currentScreenshotBase64 = '';

        const modal = document.getElementById('bookingModal');
        const formContainer = document.getElementById('modalFormContainer');
        const successContainer = document.getElementById('modalSuccessContainer');

        function formatBs(amount) {
            return amount.toLocaleString('es-VE');
        }

        function copyExactBs(btnElement) {
            copyText(currentTotalBsRaw.toString(), btnElement);
        }

        function copyText(text, btnElement) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            const originalHTML = btnElement.innerHTML;
            const isGreenBtn = btnElement.classList.contains('bg-green-500/20');
            
            btnElement.innerHTML = `<i data-lucide="check" class="w-3 h-3"></i><span>¡Copiado!</span>`;
            btnElement.classList.remove('bg-white/10', 'hover:bg-green-500', 'bg-green-500/20', 'text-green-300');
            btnElement.classList.add('bg-green-500', 'text-black');
            lucide.createIcons();

            setTimeout(() => {
                btnElement.innerHTML = originalHTML;
                btnElement.classList.remove('bg-green-500', 'text-black');
                if (isGreenBtn) {
                    btnElement.classList.add('bg-green-500/20', 'text-green-300');
                } else {
                    btnElement.classList.add('bg-white/10', 'hover:bg-green-500', 'hover:text-black');
                }
                lucide.createIcons();
            }, 2000);
        }

        function changeQty(delta) {
            const input = document.getElementById('ticketQty');
            const current = parseInt(input.value) || 1;
            const next = Math.min(20, Math.max(1, current + delta));
            input.value = next;
            updateTotal();
        }

        function resetScreenshotUpload() {
            currentScreenshotBase64 = '';
            const fileInput = document.getElementById('paymentScreenshot');
            if (fileInput) fileInput.value = '';
            document.getElementById('uploadPlaceholder').classList.remove('hidden');
            document.getElementById('uploadPreviewContainer').classList.add('hidden');
            document.getElementById('screenshotError').classList.add('hidden');
        }

        function handleScreenshotChange(event) {
            const file = event.target.files[0];
            const errorEl = document.getElementById('screenshotError');

            if (!file) {
                resetScreenshotUpload();
                return;
            }

            if (!file.type.startsWith('image/')) {
                resetScreenshotUpload();
                errorEl.textContent = '❌ El archivo debe ser una imagen (JPG, PNG, WEBP).';
                errorEl.classList.remove('hidden');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const maxDim = 900;
                    let width = img.width;
                    let height = img.height;

                    if (width > maxDim || height > maxDim) {
                        if (width > height) {
                            height = Math.round((height * maxDim) / width);
                            width = maxDim;
                        } else {
                            width = Math.round((width * maxDim) / height);
                            height = maxDim;
                        }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    currentScreenshotBase64 = canvas.toDataURL('image/jpeg', 0.72);

                    document.getElementById('uploadPreviewImg').src = currentScreenshotBase64;
                    document.getElementById('uploadFileName').textContent = file.name;
                    document.getElementById('uploadPlaceholder').classList.add('hidden');
                    document.getElementById('uploadPreviewContainer').classList.remove('hidden');
                    errorEl.classList.add('hidden');
                    lucide.createIcons();
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function openModal(ticketName, priceUsd, priceBs) {
            currentTicketName = ticketName;
            currentTicketPriceUsd = priceUsd;
            currentTicketPriceBs = priceBs;

            document.getElementById('modalTicketTitle').textContent = ticketName;
            document.getElementById('ticketQty').value = 1;
            resetScreenshotUpload();
            updateTotal();

            formContainer.classList.remove('hidden');
            successContainer.classList.add('hidden');

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function updateTotal() {
            const qty = Math.max(1, parseInt(document.getElementById('ticketQty').value) || 1);
            const totalUsd = qty * currentTicketPriceUsd;
            const totalBs = qty * currentTicketPriceBs;
            currentTotalBsRaw = totalBs;

            const formattedBs = `${formatBs(totalBs)} Bs`;
            document.getElementById('modalTotalUsd').textContent = `Equivalente a $${totalUsd} USD`;
            document.getElementById('modalTotalBs').textContent = formattedBs;
            document.getElementById('copyBsDisplay').textContent = formattedBs;
        }

        function getSavedRecords() {
            try {
                return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
            } catch (e) {
                return [];
            }
        }

        function saveRecordAutomatically(record) {
            const records = getSavedRecords();
            records.unshift(record);
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
            } catch (err) {
                if (records.length > 1) {
                    records[records.length - 1].screenshot = '';
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
                }
            }
        }

        function handleBooking(event) {
            event.preventDefault();

            if (!currentScreenshotBase64) {
                const errorEl = document.getElementById('screenshotError');
                errorEl.textContent = '❌ Debes subir la captura del PagoMóvil obligatoriamente, o la entrada NO vale.';
                errorEl.classList.remove('hidden');
                document.getElementById('uploadDropzone').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            const name = document.getElementById('buyerName').value.trim();
            const phone = document.getElementById('buyerPhone').value.trim();
            const qty = Math.max(1, parseInt(document.getElementById('ticketQty').value) || 1);
            const ref = document.getElementById('paymentRef').value.trim();
            
            const totalUsd = qty * currentTicketPriceUsd;
            const totalBs = qty * currentTicketPriceBs;
            const totalBsFormatted = `${formatBs(totalBs)} Bs`;
            const now = new Date();
            const timestamp = now.toLocaleString('es-VE', { dateStyle: 'short', timeStyle: 'short' });

            const newRecord = {
                id: 'PM-' + Date.now().toString().slice(-6),
                date: timestamp,
                name: name,
                phone: phone,
                ticket: currentTicketName,
                qty: qty,
                totalUsd: totalUsd,
                totalBs: totalBs,
                ref: ref,
                status: 'Pendiente',
                screenshot: currentScreenshotBase64
            };
            saveRecordAutomatically(newRecord);

            document.getElementById('receiptBox').innerHTML = `
                <div class="flex justify-between"><span class="text-zinc-400">ID Registro:</span> <span class="font-mono font-bold text-green-400">${newRecord.id}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Asistente:</span> <span class="font-semibold text-white">${name}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Teléfono:</span> <span class="font-semibold text-white">${phone}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Entrada:</span> <span class="font-semibold text-green-400">${qty}x ${currentTicketName}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Monto Total:</span> <span class="font-bold text-white">$${totalUsd} USD / ${totalBsFormatted}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Ref. Pago Móvil:</span> <span class="font-mono font-bold text-green-400">#${ref}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Captura PagoMóvil:</span> <span class="font-bold text-green-400">✅ Adjuntada y Guardada</span></div>
            `;

            const waText = encodeURIComponent(
                `¡Hola! Reporto mi Pago Móvil para *0 MARICOTEO* (Viernes 4 de Diciembre):\n\n` +
                `🆔 *Registro:* ${newRecord.id}\n` +
                `👤 *Nombre:* ${name}\n` +
                `📱 *Teléfono:* ${phone}\n` +
                `🎟️ *Entrada:* ${qty}x ${currentTicketName}\n` +
                `💵 *Monto:* $${totalUsd} USD / ${totalBsFormatted}\n` +
                `🧾 *Ref. Pago Móvil:* ${ref}\n` +
                `📸 *Captura:* Subida en la web\n\n` +
                `Adjunto también el capture por aquí para validar mi entrada y recibir la Secret Location.`
            );
            const waUrl = `https://wa.me/584142341557?text=${waText}`;
            document.getElementById('whatsappSendBtn').href = waUrl;

            formContainer.classList.add('hidden');
            successContainer.classList.remove('hidden');
            lucide.createIcons();
            document.getElementById('reservaForm').reset();
            resetScreenshotUpload();
        }

        /* ================= FUNCIONES PANEL ADMINISTRADOR (CLAVE: 555) ================= */
        const adminModal = document.getElementById('adminModal');
        const adminLoginView = document.getElementById('adminLoginView');
        const adminDashboardView = document.getElementById('adminDashboardView');

        function openAdminModal() {
            document.getElementById('adminPasswordInput').value = '';
            document.getElementById('adminLoginError').classList.add('hidden');
            hideAdminConfirm();
            adminLoginView.classList.remove('hidden');
            adminDashboardView.classList.add('hidden');
            adminModal.classList.remove('hidden');
            adminModal.classList.add('flex');
            setTimeout(() => document.getElementById('adminPasswordInput').focus(), 100);
        }

        function closeAdminModal() {
            adminModal.classList.add('hidden');
            adminModal.classList.remove('flex');
            hideAdminConfirm();
        }

        function verifyAdminPassword(event) {
            event.preventDefault();
            const inputPass = document.getElementById('adminPasswordInput').value.trim();
            if (inputPass === ADMIN_PASS) {
                adminLoginView.classList.add('hidden');
                adminDashboardView.classList.remove('hidden');
                renderAdminRecords();
            } else {
                document.getElementById('adminLoginError').classList.remove('hidden');
                document.getElementById('adminPasswordInput').value = '';
                document.getElementById('adminPasswordInput').focus();
            }
        }

        function toggleRecordStatus(id) {
            const records = getSavedRecords();
            const idx = records.findIndex(r => r.id === id);
            if (idx !== -1) {
                records[idx].status = records[idx].status === 'Validado' ? 'Pendiente' : 'Validado';
                localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
                renderAdminRecords();
            }
        }

        function showAdminConfirm(message, onConfirmCallback, showYesBtn = true) {
            const bar = document.getElementById('adminConfirmBar');
            document.getElementById('adminConfirmText').textContent = message;
            const yesBtn = document.getElementById('adminConfirmYesBtn');
            if (showYesBtn) {
                yesBtn.classList.remove('hidden');
                yesBtn.onclick = function() {
                    onConfirmCallback();
                    hideAdminConfirm();
                };
            } else {
                yesBtn.classList.add('hidden');
            }
            bar.classList.remove('hidden');
        }

        function hideAdminConfirm() {
            const bar = document.getElementById('adminConfirmBar');
            if (bar) bar.classList.add('hidden');
        }

        function deleteSingleRecord(id) {
            showAdminConfirm(`¿Eliminar el registro ${id} de PagoMóvil?`, () => {
                const records = getSavedRecords().filter(r => r.id !== id);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
                renderAdminRecords();
            }, true);
        }

        function askClearAllRecords() {
            if (getSavedRecords().length === 0) return;
            showAdminConfirm('¿Seguro que deseas borrar TODOS los registros guardados?', () => {
                localStorage.removeItem(STORAGE_KEY);
                renderAdminRecords();
            }, true);
        }

        function openImageViewer(recordId) {
            const record = getSavedRecords().find(r => r.id === recordId);
            if (!record || !record.screenshot) return;
            document.getElementById('viewerFullImage').src = record.screenshot;
            document.getElementById('viewerCaption').textContent = `${record.name} • Ref #${record.ref} ($${record.totalUsd} / ${formatBs(record.totalBs)} Bs)`;
            const viewer = document.getElementById('imageViewerModal');
            viewer.classList.remove('hidden');
            viewer.classList.add('flex');
        }

        function closeImageViewer() {
            const viewer = document.getElementById('imageViewerModal');
            viewer.classList.add('hidden');
            viewer.classList.remove('flex');
        }

        function renderAdminRecords() {
            const records = getSavedRecords();
            const listContainer = document.getElementById('adminRecordsList');

            let totalEntradas = 0;
            let totalUsd = 0;
            let totalBs = 0;

            records.forEach(r => {
                totalEntradas += Number(r.qty) || 0;
                totalUsd += Number(r.totalUsd) || 0;
                totalBs += Number(r.totalBs) || 0;
            });

            document.getElementById('statTotalRegistros').textContent = records.length;
            document.getElementById('statTotalEntradas').textContent = totalEntradas;
            document.getElementById('statTotalRecaudado').textContent = `$${totalUsd} / ${formatBs(totalBs)} Bs`;

            if (records.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-12 px-4 rounded-2xl bg-black/60 border border-white/10 text-zinc-400">
                        <p class="text-sm font-semibold text-white">Aún no hay PagoMóvil registrados</p>
                        <p class="text-xs mt-1">Cuando alguien compre una entrada general y suba su captura, aparecerá aquí automáticamente.</p>
                    </div>
                `;
                return;
            }

            listContainer.innerHTML = records.map(r => {
                const isValidated = r.status === 'Validado';
                const statusBadge = isValidated
                    ? `<span class="px-2.5 py-0.5 rounded-full bg-green-500/20 text-green-400 text-[11px] font-bold">✅ Validado</span>`
                    : `<span class="px-2.5 py-0.5 rounded-full bg-yellow-500/20 text-yellow-300 text-[11px] font-bold">⏳ Pendiente</span>`;

                const thumbHtml = r.screenshot
                    ? `<button type="button" onclick="openImageViewer('${r.id}')" class="group relative w-16 h-16 rounded-xl overflow-hidden border border-green-500/40 shrink-0 bg-black" title="Ver captura en grande">
                           <img src="${r.screenshot}" alt="Capture ${r.name}" class="w-full h-full object-cover group-hover:scale-110 transition-transform">
                           <span class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center text-[10px] font-bold text-white transition-opacity">Ver</span>
                       </button>`
                    : `<div class="w-16 h-16 rounded-xl border border-white/10 bg-black flex items-center justify-center text-[10px] text-zinc-500 shrink-0 text-center p-1">Sin img</div>`;

                return `
                    <div class="p-4 rounded-2xl bg-black/80 border ${isValidated ? 'border-green-500/40' : 'border-white/10'} flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex items-start gap-3.5">
                            ${thumbHtml}
                            <div class="space-y-1 text-xs">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-bold text-sm text-white">${r.name}</span>
                                    ${statusBadge}
                                    <span class="text-[11px] text-zinc-500 font-mono">${r.id} • ${r.date}</span>
                                </div>
                                <p class="text-zinc-300">
                                    📱 <span class="font-semibold">${r.phone}</span> • 🎟️ <span class="text-green-400 font-bold">${r.qty}x ${r.ticket}</span>
                                </p>
                                <p class="text-zinc-300">
                                    💵 <span class="font-bold text-white">$${r.totalUsd} USD / ${formatBs(r.totalBs)} Bs</span> • 🧾 Ref: <span class="font-mono font-bold text-green-400">#${r.ref}</span>
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
                            ${r.screenshot ? `<button type="button" onclick="openImageViewer('${r.id}')" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-green-500/20 text-xs font-semibold text-white transition-all">Ver Capture</button>` : ''}
                            <button type="button" onclick="toggleRecordStatus('${r.id}')" class="px-3 py-1.5 rounded-lg ${isValidated ? 'bg-yellow-500/20 text-yellow-300 hover:bg-yellow-500/30' : 'bg-green-500 text-black hover:bg-green-400'} text-xs font-bold transition-all">
                                ${isValidated ? 'Marcar Pendiente' : 'Validar Entrada'}
                            </button>
                            <button type="button" onclick="deleteSingleRecord('${r.id}')" title="Eliminar" class="p-1.5 rounded-lg bg-red-500/15 hover:bg-red-500/30 text-red-400 transition-all">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            lucide.createIcons();
        }

        function exportRecordsCSV() {
            const records = getSavedRecords();
            if (records.length === 0) {
                showAdminConfirm('No hay registros guardados todavía para exportar.', () => {}, false);
                return;
            }
            const headers = ['ID', 'Fecha', 'Nombre', 'Telefono', 'Entrada', 'Cantidad', 'Total_USD', 'Total_Bs', 'Referencia', 'Estado'];
            const rows = records.map(r => [
                r.id,
                `"${r.date}"`,
                `"${r.name.replace(/"/g, '""')}"`,
                `"${r.phone}"`,
                `"${r.ticket}"`,
                r.qty,
                r.totalUsd,
                r.totalBs,
                `"${r.ref}"`,
                r.status
            ].join(','));

            const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows].join('\n');
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement('a');
            link.setAttribute('href', encodedUri);
            link.setAttribute('download', 'registros_pagomovil_0_maricoteo.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });
        adminModal.addEventListener('click', (e) => {
            if (e.target === adminModal) closeAdminModal();
        });
    </script>
</body>
</html>
