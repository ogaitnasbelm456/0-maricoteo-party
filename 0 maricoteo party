                <a href="#info" class="hover:text-green-400 transition-colors">El Evento</a>
                <a href="#galeria-vibe" class="hover:text-green-400 transition-colors">La Vibra</a>
                <a href="#ubicacion" class="hover:text-green-400 transition-colors">Ubicación</a>
