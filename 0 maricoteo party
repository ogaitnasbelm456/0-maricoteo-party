<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>0 MARICOTEO | Preventa Oficial</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Syne (Display urbana) e Inter (Lectura limpia) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Syne', 'sans-serif'],
                    },
                    colors: {
                        dark: '#000000',
                        card: '#09090b',
                        creeper: '#22c55e',
                        creeperBright: '#4ade80',
                    },
                    animation: {
                        'float-slow': 'floatSlow 4.5s ease-in-out infinite',
                        'pulse-glow': 'pulseGlow 3.5s ease-in-out infinite',
                    },
                    keyframes: {
                        floatSlow: {
                            '0%, 100%': { transform: 'translateY(0px) rotate(-2deg)' },
                            '50%': { transform: 'translateY(-14px) rotate(2deg)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { filter: 'drop-shadow(0 0 22px rgba(74,222,128,0.55))' },
                            '50%': { filter: 'drop-shadow(0 0 38px rgba(34,197,94,0.9))' },
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-black text-white antialiased selection:bg-green-500 selection:text-black overflow-x-hidden">

    <!-- Fondo fijo a pantalla completa con foto local o respaldo patrón pixel Creeper neón -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden bg-black">
        <img 
            src="1066297649361851263.jpg" 
            alt="Creeper Nike Fondo" 
            onerror="this.style.display='none'; document.getElementById('bgFallbackPattern').classList.remove('hidden');"
            class="w-full h-full object-cover object-center blur-sm scale-105 opacity-45 transition-all duration-700"
        >
        <!-- Respaldo visual temático si la imagen local no existe -->
        <div id="bgFallbackPattern" class="hidden absolute inset-0 opacity-35">
            <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <pattern id="creeperGrid" width="80" height="80" patternUnits="userSpaceOnUse">
                        <rect width="80" height="80" fill="#000000"/>
                        <rect x="8" y="8" width="16" height="16" fill="#22c55e" fill-opacity="0.16"/>
                        <rect x="48" y="24" width="16" height="16" fill="#4ade80" fill-opacity="0.12"/>
                        <rect x="24" y="52" width="12" height="12" fill="#22c55e" fill-opacity="0.18"/>
                        <path d="M 80 0 L 0 0 0 80" fill="none" stroke="#22c55e" stroke-opacity="0.12" stroke-width="1"/>
                    </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#creeperGrid)"/>
            </svg>
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/55 to-black/90"></div>
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-green-500/20 rounded-full blur-[130px]"></div>
